# AWS-AUTH: oidc
# Container scan + SBOM workflow (Docker Scout — alternative)
#
# Generated by .cursor/skills/aws-platform-engineering capability
# `generate-container-scan-scout-workflow` per ADR-005 (container supply chain).
#
# Sources:
#   - Docker Scout:        https://docs.docker.com/scout/
#   - docker/scout-action: https://github.com/docker/scout-action
#   - SPDX 2.3:            https://spdx.dev/
#   - CycloneDX 1.5:       https://cyclonedx.org/
#
# Use this alternative when:
#   - Docker Hub / Docker Desktop is already part of the developer's loop, OR
#   - The org has an active Docker Scout subscription with policy + remediation
#     features the team is using.
# Otherwise prefer the Trivy default (`generate-container-scan-workflow`).
#
# Decision boundary (ADR-005 §Container supply chain): Trivy default; Scout
# documented alternative; SAME SARIF + SBOM artifact contract — these
# workflows are interchangeable from a downstream-consumer perspective.

name: {{workflow_name}}

on:
  pull_request:
    paths:
      - "{{dockerfile_dir}}/**"
      - ".github/workflows/{{workflow_filename}}"
  push:
    branches: [release]
    paths:
      - "{{dockerfile_dir}}/**"
  workflow_dispatch:

permissions:
  id-token: write
  contents: read
  packages: read
  security-events: write
  pull-requests: write

concurrency:
  group: container-scan-scout-${{ github.workflow }}-${{ github.ref }}
  cancel-in-progress: false

env:
  AWS_REGION: {{aws_region}}
  ECR_REPO: {{ecr_repo}}
  IMAGE_TAG: ${{ github.sha }}
  SEVERITY_GATE: "high,critical"   # Scout uses lowercase severity tokens

jobs:
  build:
    name: Build image
    runs-on: ubuntu-latest
    outputs:
      image_uri: ${{ steps.tag.outputs.image_uri }}
    steps:
      - name: Checkout
        uses: actions/checkout@v4   # pin to a verified SHA before merge

      - name: Configure AWS credentials via OIDC
        uses: aws-actions/configure-aws-credentials@v4   # pin to a verified SHA before merge
        with:
          role-to-assume: ${{ vars.OIDC_ROLE_ECR_PUSH }}
          aws-region: ${{ env.AWS_REGION }}
          audience: sts.amazonaws.com

      - name: Login to Amazon ECR
        id: ecr_login
        uses: aws-actions/amazon-ecr-login@v2   # pin to a verified SHA before merge

      - name: Compute image tag
        id: tag
        run: |
          IMAGE_URI="${{ steps.ecr_login.outputs.registry }}/${{ env.ECR_REPO }}:${{ env.IMAGE_TAG }}"
          echo "image_uri=$IMAGE_URI" >> "$GITHUB_OUTPUT"

      - name: Set up Docker Buildx
        uses: docker/setup-buildx-action@v3   # pin to a verified SHA before merge

      # Login to Docker Hub for Scout (Scout requires Docker Hub auth even
      # for ECR-resident images).
      - name: Docker Hub login (for Scout)
        uses: docker/login-action@v3   # pin to a verified SHA before merge
        with:
          username: ${{ secrets.DOCKERHUB_USERNAME }}
          password: ${{ secrets.DOCKERHUB_TOKEN }}

      - name: Build (and push only on release)
        uses: docker/build-push-action@v6   # pin to a verified SHA before merge
        with:
          context: {{dockerfile_dir}}
          file: {{dockerfile_dir}}/Dockerfile
          push: ${{ github.event_name == 'push' && github.ref == 'refs/heads/release' }}
          tags: ${{ steps.tag.outputs.image_uri }}
          provenance: true
          sbom: false
          cache-from: type=gha
          cache-to: type=gha,mode=max
          load: ${{ github.event_name == 'pull_request' }}

  scout-cves:
    name: Docker Scout — CVE scan (gate: ${{ env.SEVERITY_GATE }})
    runs-on: ubuntu-latest
    needs: build
    steps:
      - name: Checkout
        uses: actions/checkout@v4   # pin to a verified SHA before merge

      - name: Configure AWS credentials via OIDC
        uses: aws-actions/configure-aws-credentials@v4   # pin to a verified SHA before merge
        with:
          role-to-assume: ${{ vars.OIDC_ROLE_ECR_PULL }}
          aws-region: ${{ env.AWS_REGION }}
          audience: sts.amazonaws.com

      - name: Login to Amazon ECR
        uses: aws-actions/amazon-ecr-login@v2   # pin to a verified SHA before merge

      - name: Docker Hub login
        uses: docker/login-action@v3   # pin to a verified SHA before merge
        with:
          username: ${{ secrets.DOCKERHUB_USERNAME }}
          password: ${{ secrets.DOCKERHUB_TOKEN }}

      - name: Scout — quickview (summary)
        uses: docker/scout-action@v1   # pin to a verified SHA before merge
        with:
          command: quickview
          image: ${{ needs.build.outputs.image_uri }}
          only-severities: ${{ env.SEVERITY_GATE }}
          write-comment: ${{ github.event_name == 'pull_request' }}

      - name: Scout — CVEs (gate; fail on ${{ env.SEVERITY_GATE }})
        uses: docker/scout-action@v1   # pin to a verified SHA before merge
        with:
          command: cves
          image: ${{ needs.build.outputs.image_uri }}
          only-severities: ${{ env.SEVERITY_GATE }}
          exit-code: true
          ignore-unchanged: true
          sarif-file: scout-results.sarif

      - name: Upload SARIF to GitHub Security tab
        if: always()
        uses: github/codeql-action/upload-sarif@v3   # pin to a verified SHA before merge
        with:
          sarif_file: scout-results.sarif
          category: docker-scout

  scout-sbom:
    name: Docker Scout — SBOM (SPDX + CycloneDX)
    runs-on: ubuntu-latest
    needs: build
    steps:
      - name: Checkout
        uses: actions/checkout@v4   # pin to a verified SHA before merge

      - name: Configure AWS credentials via OIDC
        uses: aws-actions/configure-aws-credentials@v4   # pin to a verified SHA before merge
        with:
          role-to-assume: ${{ vars.OIDC_ROLE_ECR_PULL }}
          aws-region: ${{ env.AWS_REGION }}
          audience: sts.amazonaws.com

      - name: Login to Amazon ECR
        uses: aws-actions/amazon-ecr-login@v2   # pin to a verified SHA before merge

      - name: Docker Hub login
        uses: docker/login-action@v3   # pin to a verified SHA before merge
        with:
          username: ${{ secrets.DOCKERHUB_USERNAME }}
          password: ${{ secrets.DOCKERHUB_TOKEN }}

      - name: Scout — SBOM (SPDX 2.3 JSON)
        uses: docker/scout-action@v1   # pin to a verified SHA before merge
        with:
          command: sbom
          image: ${{ needs.build.outputs.image_uri }}
          format: spdx
          output: sbom.spdx.json

      - name: Scout — SBOM (CycloneDX 1.5 JSON)
        uses: docker/scout-action@v1   # pin to a verified SHA before merge
        with:
          command: sbom
          image: ${{ needs.build.outputs.image_uri }}
          format: list
          output: sbom.cdx.json
        # NOTE: as of Scout v1, native CycloneDX export uses --format spdx
        # mapping; for guaranteed CycloneDX 1.5 output prefer the Trivy
        # workflow OR run `syft <image> -o cyclonedx-json=sbom.cdx.json` here.

      - name: Upload SBOMs as workflow artifact
        uses: actions/upload-artifact@v4   # pin to a verified SHA before merge
        with:
          name: sbom-${{ github.sha }}
          path: |
            sbom.spdx.json
            sbom.cdx.json
          retention-days: 90
