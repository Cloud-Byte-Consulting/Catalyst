# ECR scan-on-push enablement — Terraform
#
# Generated by skills/aws-platform-engineering capability
# `generate-ecr-scan-on-push` per ADR-005 (container supply chain).
#
# Sources:
#   - ECR enhanced scanning:  https://docs.aws.amazon.com/AmazonECR/latest/userguide/image-scanning-enhanced.html
#   - Inspector V2 + ECR:     https://docs.aws.amazon.com/inspector/latest/user/scanning-ecr.html
#   - aws_ecr_repository:     https://registry.terraform.io/providers/hashicorp/aws/latest/docs/resources/ecr_repository
#   - aws_ecr_registry_scanning_configuration:
#                             https://registry.terraform.io/providers/hashicorp/aws/latest/docs/resources/ecr_registry_scanning_configuration
#
# Two layers, both REQUIRED for prod workloads:
#   1. Per-repository: scan_on_push = true (basic per-image trigger).
#   2. Registry-wide: ENHANCED scanning via Inspector V2 (continuous scanning;
#      findings flow to AWS Security Hub via the standard SecHub integration).

# ============================================================================
# variables
# ============================================================================
variable "repo_name" {
  description = "ECR repo name (e.g., catalyst-api)."
  type        = string
  default     = "{{ecr_repo_name}}"
}

variable "scan_frequency" {
  description = "Inspector V2 continuous scan frequency. Use SCAN_ON_PUSH for low-traffic repos and CONTINUOUS_SCAN for prod."
  type        = string
  default     = "{{scan_frequency}}"   # SCAN_ON_PUSH | CONTINUOUS_SCAN
  validation {
    condition     = contains(["SCAN_ON_PUSH", "CONTINUOUS_SCAN"], var.scan_frequency)
    error_message = "scan_frequency must be SCAN_ON_PUSH or CONTINUOUS_SCAN."
  }
}

# ============================================================================
# Per-repository: scan-on-push (basic) + immutable tags + KMS encryption
# ============================================================================
resource "aws_ecr_repository" "this" {
  name                 = var.repo_name
  image_tag_mutability = "IMMUTABLE"   # never overwrite a tag silently

  image_scanning_configuration {
    scan_on_push = true
  }

  encryption_configuration {
    encryption_type = "KMS"
    kms_key         = var.kms_key_arn
  }

  tags = merge(local.common_tags, { Name = var.repo_name })
}

# Lifecycle policy — keep last N tagged + expire untagged after 14 days
resource "aws_ecr_lifecycle_policy" "this" {
  repository = aws_ecr_repository.this.name

  policy = jsonencode({
    rules = [
      {
        rulePriority = 1
        description  = "Keep last 30 tagged images"
        selection = {
          tagStatus     = "tagged"
          tagPatternList = ["*"]
          countType     = "imageCountMoreThan"
          countNumber   = 30
        }
        action = { type = "expire" }
      },
      {
        rulePriority = 2
        description  = "Expire untagged images older than 14 days"
        selection = {
          tagStatus   = "untagged"
          countType   = "sinceImagePushed"
          countUnit   = "days"
          countNumber = 14
        }
        action = { type = "expire" }
      },
    ]
  })
}

# ============================================================================
# Registry-wide: ENHANCED scanning via Inspector V2 (account-level)
# ============================================================================
# This resource is account-wide; declare it ONCE per account (typically in
# the security-tooling or shared-services account, NOT per workload).
# Findings flow to AWS Security Hub when SecHub is the delegated admin in the
# Security Tooling account (per SRA architecture).
resource "aws_ecr_registry_scanning_configuration" "this" {
  scan_type = "ENHANCED"

  rule {
    scan_frequency = var.scan_frequency

    repository_filter {
      filter      = "*"
      filter_type = "WILDCARD"
    }
  }
}

# ============================================================================
# Outputs
# ============================================================================
output "repository_url" {
  description = "ECR repository URL (use as the docker push target)."
  value       = aws_ecr_repository.this.repository_url
}

output "repository_arn" {
  description = "ECR repository ARN (use in IAM policies that grant push/pull)."
  value       = aws_ecr_repository.this.arn
}

# ============================================================================
# locals
# ============================================================================
locals {
  common_tags = {
    Tenant      = var.tenant
    Environment = var.environment
    LandingZone = var.landing_zone
    Project     = var.project
    Application = var.application
    ManagedBy   = "terraform"
    Module      = "ecr-scan-on-push"
  }
}
