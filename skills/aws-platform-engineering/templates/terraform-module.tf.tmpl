# Terraform module template — {{module_name}}
#
# This template renders four files under
# `infrastructure/modules/{{module_type}}/{{module_name}}/`:
#   - versions.tf  (this section)
#   - variables.tf
#   - outputs.tf
#   - main.tf
#   - README.md
#   - examples/basic/main.tf
#
# Generated by skills/aws-platform-engineering capability
# `generate-terraform-module` per ADR-005.
#
# Sources (AWS-prescriptive):
#   https://docs.aws.amazon.com/prescriptive-guidance/latest/aws-caf-platform-perspective/platform-eng.html
#   (CAF Platform: "use IaC to define configurations declaratively")

# ============================================================================
# versions.tf
# ============================================================================
terraform {
  required_version = "~> 1.9"

  required_providers {
    aws = {
      source  = "hashicorp/aws"
      version = "{{aws_provider_version}}"
    }
  }
}

# ============================================================================
# variables.tf
# ============================================================================
# Each input MUST have type, description, and (for non-required) default.
# Construct-anchor inputs are required for every Catalyst-managed module so the
# generated resources can be tagged consistently per ADR-002.

variable "tenant" {
  description = "Catalyst tenant slug (e.g., `catalyst`). Maps to the `tenant/*` issue label."
  type        = string
}

variable "environment" {
  description = "Static environment slug: dev | stage | prod | preview-<suffix>."
  type        = string
  validation {
    condition     = contains(["dev", "stage", "prod"], var.environment) || startswith(var.environment, "preview-")
    error_message = "environment must be dev, stage, prod, or preview-<suffix>."
  }
}

variable "landing_zone" {
  description = "Landing-zone slug (per ADR-002)."
  type        = string
}

variable "project" {
  description = "Project slug (per ADR-002)."
  type        = string
}

variable "application" {
  description = "Application slug (per ADR-002)."
  type        = string
}

# ----- module-specific inputs follow -----
# Each input MUST include description and type. Defaults only when sensible.
# Example:
#
# variable "bucket_name" {
#   description = "Name of the S3 bucket. Must be globally unique."
#   type        = string
# }

# ============================================================================
# outputs.tf
# ============================================================================
# Outputs MUST include description. Sensitive outputs use `sensitive = true`.
# Example:
#
# output "bucket_arn" {
#   description = "ARN of the created S3 bucket."
#   value       = aws_s3_bucket.this.arn
# }

# ============================================================================
# main.tf
# ============================================================================
# Tag every resource with the construct anchors so the resource is auditable
# back to the issue / project / app that produced it.

locals {
  common_tags = {
    Tenant      = var.tenant
    Environment = var.environment
    LandingZone = var.landing_zone
    Project     = var.project
    Application = var.application
    ManagedBy   = "terraform"
    Module      = "{{module_name}}"
  }
}

