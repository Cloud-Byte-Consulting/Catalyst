# Bedrock-backed gen-AI service — {{service_name}}
#
# Generated by skills/aws-platform-engineering capability
# `generate-bedrock-service-skeleton` per ADR-005 G-10.
#
# Implements the GenAI platform-engineering blueprint:
#   https://aws.amazon.com/blogs/machine-learning/accelerating-generative-ai-applications-with-a-platform-engineering-approach/
#
# Composes:
#   - Connectors:    API Gateway + WAF
#   - Controls:      Bedrock Guardrails (toxicity / PII redaction); pre-response sanitiser
#   - Data:          Bedrock Knowledge Base (optional) + Lake Formation grants
#   - Observability: CloudWatch metrics + X-Ray + OpenSearch index for prompt history
#   - Orchestration: Step Functions (multistep) + DynamoDB prompt-state table
#   - LLM:           Bedrock with explicit model ID pin

# ============================================================================
# variables
# ============================================================================
variable "service_name" {
  description = "Service slug (kebab-case)."
  type        = string
  default     = "{{service_name}}"
}

variable "bedrock_model_id" {
  description = "Pinned Bedrock model ID. Drift is rejected."
  type        = string
  default     = "{{bedrock_model_id}}"
}

variable "kb_id" {
  description = "Bedrock Knowledge Base ID. null disables RAG."
  type        = string
  default     = null
}

variable "multistep" {
  description = "If true, generate a Step Functions state machine for multi-step orchestration."
  type        = bool
  default     = {{multistep}}
}

variable "daily_token_budget" {
  description = "Daily Bedrock token budget per env (Heijunka throttle)."
  type        = number
  default     = 1000000
}

# ============================================================================
# Bedrock Guardrails — toxicity, PII, denied topics
# ============================================================================
resource "aws_bedrock_guardrail" "this" {
  name                      = "${var.service_name}-guardrail"
  blocked_input_messaging   = "Your request was blocked by Catalyst's gen-AI policy."
  blocked_outputs_messaging = "Response withheld by Catalyst's gen-AI output policy."

  content_policy_config {
    filters_config {
      input_strength  = "HIGH"
      output_strength = "HIGH"
      type            = "VIOLENCE"
    }
    filters_config {
      input_strength  = "HIGH"
      output_strength = "HIGH"
      type            = "HATE"
    }
    filters_config {
      input_strength  = "HIGH"
      output_strength = "HIGH"
      type            = "SEXUAL"
    }
    filters_config {
      input_strength  = "HIGH"
      output_strength = "HIGH"
      type            = "INSULTS"
    }
    filters_config {
      input_strength  = "HIGH"
      output_strength = "HIGH"
      type            = "MISCONDUCT"
    }
  }

  sensitive_information_policy_config {
    pii_entities_config {
      action = "BLOCK"
      type   = "EMAIL"
    }
    pii_entities_config {
      action = "BLOCK"
      type   = "US_SOCIAL_SECURITY_NUMBER"
    }
    pii_entities_config {
      action = "BLOCK"
      type   = "CREDIT_DEBIT_CARD_NUMBER"
    }
    pii_entities_config {
      action = "ANONYMIZE"
      type   = "NAME"
    }
  }

  word_policy_config {
    managed_word_lists_config {
      type = "PROFANITY"
    }
  }

  tags = local.common_tags
}

# ============================================================================
# DynamoDB — prompt / agent state with TTL (per GenAI blueprint Orchestration)
# ============================================================================
resource "aws_dynamodb_table" "prompt_state" {
  name         = "${var.service_name}-prompt-state"
  billing_mode = "PAY_PER_REQUEST"
  hash_key     = "session_id"
  range_key    = "step"

  attribute {
    name = "session_id"
    type = "S"
  }
  attribute {
    name = "step"
    type = "N"
  }

  ttl {
    attribute_name = "expires_at"
    enabled        = true
  }

  point_in_time_recovery {
    enabled = true
  }

  server_side_encryption {
    enabled     = true
    kms_key_arn = var.kms_key_arn
  }

  tags = local.common_tags
}

# ============================================================================
# DynamoDB — daily token budget (Heijunka throttle)
# ============================================================================
resource "aws_dynamodb_table" "token_budget" {
  name         = "${var.service_name}-token-budget"
  billing_mode = "PAY_PER_REQUEST"
  hash_key     = "budget_date"

  attribute {
    name = "budget_date"
    type = "S"
  }

  ttl {
    attribute_name = "expires_at"
    enabled        = true
  }

  server_side_encryption {
    enabled     = true
    kms_key_arn = var.kms_key_arn
  }

  tags = local.common_tags
}

# ============================================================================
# Lambda — the service handler
# ============================================================================
resource "aws_lambda_function" "this" {
  function_name = var.service_name
  role          = aws_iam_role.lambda.arn
  handler       = "app.handler"
  runtime       = "python3.12"
  timeout       = 60
  memory_size   = 1024
  filename      = var.lambda_zip_path
  source_code_hash = filebase64sha256(var.lambda_zip_path)

  tracing_config {
    mode = "Active"   # X-Ray
  }

  environment {
    variables = {
      BEDROCK_MODEL_ID    = var.bedrock_model_id
      GUARDRAIL_ID        = aws_bedrock_guardrail.this.guardrail_id
      GUARDRAIL_VERSION   = aws_bedrock_guardrail.this.version
      KB_ID               = var.kb_id == null ? "" : var.kb_id
      PROMPT_STATE_TABLE  = aws_dynamodb_table.prompt_state.name
      TOKEN_BUDGET_TABLE  = aws_dynamodb_table.token_budget.name
      DAILY_TOKEN_BUDGET  = tostring(var.daily_token_budget)
      LOG_LEVEL           = "INFO"
    }
  }

  tags = local.common_tags
}

# ============================================================================
# IAM — least-privilege; explicit Bedrock model + guardrail ARNs
# ============================================================================
data "aws_iam_policy_document" "lambda_assume" {
  statement {
    actions = ["sts:AssumeRole"]
    principals {
      type        = "Service"
      identifiers = ["lambda.amazonaws.com"]
    }
  }
}

resource "aws_iam_role" "lambda" {
  name               = "${var.service_name}-lambda"
  assume_role_policy = data.aws_iam_policy_document.lambda_assume.json
  tags               = local.common_tags
}

data "aws_iam_policy_document" "lambda" {
  statement {
    sid    = "InvokeBedrockModel"
    effect = "Allow"
    actions = [
      "bedrock:InvokeModel",
      "bedrock:InvokeModelWithResponseStream",
      "bedrock:ApplyGuardrail",
    ]
    resources = [
      "arn:aws:bedrock:${var.region}::foundation-model/${var.bedrock_model_id}",
      aws_bedrock_guardrail.this.guardrail_arn,
    ]
  }

  statement {
    sid    = "PromptStateRW"
    effect = "Allow"
    actions = [
      "dynamodb:GetItem",
      "dynamodb:PutItem",
      "dynamodb:UpdateItem",
      "dynamodb:Query",
    ]
    resources = [
      aws_dynamodb_table.prompt_state.arn,
      aws_dynamodb_table.token_budget.arn,
    ]
  }

  statement {
    sid    = "Logs"
    effect = "Allow"
    actions = [
      "logs:CreateLogStream",
      "logs:PutLogEvents",
    ]
    resources = [
      "arn:aws:logs:${var.region}:${data.aws_caller_identity.current.account_id}:log-group:/aws/lambda/${var.service_name}:*",
    ]
  }

  dynamic "statement" {
    for_each = var.kb_id == null ? [] : [1]
    content {
      sid    = "RetrieveFromKnowledgeBase"
      effect = "Allow"
      actions = [
        "bedrock:Retrieve",
        "bedrock:RetrieveAndGenerate",
      ]
      resources = [
        "arn:aws:bedrock:${var.region}:${data.aws_caller_identity.current.account_id}:knowledge-base/${var.kb_id}",
      ]
    }
  }
}

resource "aws_iam_role_policy" "lambda" {
  role   = aws_iam_role.lambda.id
  policy = data.aws_iam_policy_document.lambda.json
}

# ============================================================================
# Step Functions (only when multistep=true) — orchestration per GenAI blueprint
# ============================================================================
resource "aws_sfn_state_machine" "this" {
  count    = var.multistep ? 1 : 0
  name     = "${var.service_name}-orchestrator"
  role_arn = aws_iam_role.sfn[0].arn

  definition = jsonencode({
    Comment = "Multistep orchestration for ${var.service_name}"
    StartAt = "PrepareContext"
    States = {
      PrepareContext = {
        Type     = "Task"
        Resource = aws_lambda_function.this.arn
        Next     = "InvokeBedrock"
      }
      InvokeBedrock = {
        Type     = "Task"
        Resource = aws_lambda_function.this.arn
        Retry = [{
          ErrorEquals     = ["States.TaskFailed"]
          IntervalSeconds = 2
          MaxAttempts     = 3
          BackoffRate     = 2.0
        }]
        Next = "Sanitize"
      }
      Sanitize = {
        Type     = "Task"
        Resource = aws_lambda_function.this.arn
        End      = true
      }
    }
  })

  tags = local.common_tags
}

resource "aws_iam_role" "sfn" {
  count = var.multistep ? 1 : 0
  name  = "${var.service_name}-sfn"

  assume_role_policy = jsonencode({
    Version = "2012-10-17"
    Statement = [{
      Effect    = "Allow"
      Principal = { Service = "states.amazonaws.com" }
      Action    = "sts:AssumeRole"
    }]
  })

  tags = local.common_tags
}

# ============================================================================
# locals
# ============================================================================
locals {
  common_tags = {
    Tenant      = var.tenant
    Environment = var.environment
    LandingZone = var.landing_zone
    Project     = var.project
    Application = var.application
    ManagedBy   = "terraform"
    Module      = "bedrock-service"
    Service     = var.service_name
  }
}

data "aws_caller_identity" "current" {}
