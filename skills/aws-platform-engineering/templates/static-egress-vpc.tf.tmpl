# Static-outbound-IP serverless VPC — {{vpc_name}}
#
# Generated by .cursor/skills/aws-platform-engineering capability
# `generate-static-egress-vpc` per ADR-005 G-7.
#
# Source (AWS-prescriptive):
#   https://docs.aws.amazon.com/prescriptive-guidance/latest/patterns/generate-a-static-outbound-ip-address-using-a-lambda-function-amazon-vpc-and-a-serverless-architecture.html
#
# Layout (HA default — two AZs, two NAT gateways):
#
#   Internet
#      ▲
#   ┌──┴──┐
#   │ IGW │
#   └──┬──┘
#      │
#   ┌──┴──────────────────────────┐
#   │ VPC ({{cidr}})              │
#   │                             │
#   │  ┌─────────┐  ┌─────────┐   │
#   │  │ public-a│  │ public-b│   │  <- public subnets (NAT GW + EIP each)
#   │  │ NAT-A   │  │ NAT-B   │   │     EIPs are the static egress addresses
#   │  │ EIP-A   │  │ EIP-B   │   │
#   │  └────┬────┘  └────┬────┘   │
#   │       │            │        │
#   │  ┌────┴─────┐ ┌────┴─────┐  │
#   │  │ priv-a   │ │ priv-b   │  │  <- private subnets (Lambda lives here)
#   │  └──────────┘ └──────────┘  │
#   └─────────────────────────────┘
#
# Cost note (~$65/mo per NAT GW at idle):
#   Two NATs across AZs is HA-correct. Single-NAT cost-saving override is
#   documented but not the default. Track NAT spend via tag Purpose=static-egress.

# ============================================================================
# variables
# ============================================================================
variable "vpc_name" {
  description = "VPC name (kebab-case)."
  type        = string
  default     = "{{vpc_name}}"
}

variable "cidr" {
  description = "VPC CIDR block. /25 default per the AWS pattern."
  type        = string
  default     = "{{cidr}}"
}

variable "azs" {
  description = "Two AZs for HA. Single-AZ override only with explicit cost waiver."
  type        = list(string)
  validation {
    condition     = length(var.azs) >= 2
    error_message = "Two AZs required for HA. Single-AZ requires explicit cost waiver."
  }
}

variable "lambda_function_name" {
  description = "Lambda function to attach to the private subnets. null = pure VPC, attach later."
  type        = string
  default     = null
}

# ============================================================================
# VPC + IGW
# ============================================================================
resource "aws_vpc" "this" {
  cidr_block           = var.cidr
  enable_dns_hostnames = true
  enable_dns_support   = true

  tags = merge(local.common_tags, { Name = var.vpc_name })
}

resource "aws_internet_gateway" "this" {
  vpc_id = aws_vpc.this.id
  tags   = merge(local.common_tags, { Name = "${var.vpc_name}-igw" })
}

# ============================================================================
# Public subnets (one per AZ) + NAT GW + EIP per AZ
# ============================================================================
resource "aws_subnet" "public" {
  count                   = length(var.azs)
  vpc_id                  = aws_vpc.this.id
  availability_zone       = var.azs[count.index]
  cidr_block              = cidrsubnet(var.cidr, 4, count.index)
  map_public_ip_on_launch = true

  tags = merge(local.common_tags, {
    Name = "${var.vpc_name}-public-${var.azs[count.index]}"
    Tier = "public"
  })
}

resource "aws_eip" "nat" {
  count  = length(var.azs)
  domain = "vpc"

  tags = merge(local.common_tags, {
    Name    = "${var.vpc_name}-nat-eip-${var.azs[count.index]}"
    Purpose = "static-egress"
  })
}

resource "aws_nat_gateway" "this" {
  count         = length(var.azs)
  allocation_id = aws_eip.nat[count.index].id
  subnet_id     = aws_subnet.public[count.index].id

  tags = merge(local.common_tags, { Name = "${var.vpc_name}-nat-${var.azs[count.index]}" })

  depends_on = [aws_internet_gateway.this]
}

# ============================================================================
# Private subnets (one per AZ) — Lambda or ECS lives here
# ============================================================================
resource "aws_subnet" "private" {
  count             = length(var.azs)
  vpc_id            = aws_vpc.this.id
  availability_zone = var.azs[count.index]
  cidr_block        = cidrsubnet(var.cidr, 4, count.index + length(var.azs))

  tags = merge(local.common_tags, {
    Name = "${var.vpc_name}-private-${var.azs[count.index]}"
    Tier = "private"
  })
}

# ============================================================================
# Route tables
# ============================================================================
resource "aws_route_table" "public" {
  vpc_id = aws_vpc.this.id

  route {
    cidr_block = "0.0.0.0/0"
    gateway_id = aws_internet_gateway.this.id
  }

  tags = merge(local.common_tags, { Name = "${var.vpc_name}-public-rt" })
}

resource "aws_route_table_association" "public" {
  count          = length(var.azs)
  subnet_id      = aws_subnet.public[count.index].id
  route_table_id = aws_route_table.public.id
}

resource "aws_route_table" "private" {
  count  = length(var.azs)
  vpc_id = aws_vpc.this.id

  route {
    cidr_block     = "0.0.0.0/0"
    nat_gateway_id = aws_nat_gateway.this[count.index].id
  }

  tags = merge(local.common_tags, {
    Name = "${var.vpc_name}-private-rt-${var.azs[count.index]}"
  })
}

resource "aws_route_table_association" "private" {
  count          = length(var.azs)
  subnet_id      = aws_subnet.private[count.index].id
  route_table_id = aws_route_table.private[count.index].id
}

# ============================================================================
# Lambda VPC config (only when lambda_function_name is set)
# ============================================================================
resource "aws_lambda_function_event_invoke_config" "lambda_vpc_attach" {
  count         = var.lambda_function_name == null ? 0 : 1
  function_name = var.lambda_function_name
}

# ============================================================================
# Outputs — the static egress IPs partners must allowlist
# ============================================================================
output "static_egress_eips" {
  description = "Elastic IP addresses that are the static egress IPs. Allowlist these at partner firewalls."
  value       = aws_eip.nat[*].public_ip
}

output "private_subnet_ids" {
  description = "Private subnet IDs. Attach Lambda or ECS tasks here for static egress."
  value       = aws_subnet.private[*].id
}

# ============================================================================
# locals
# ============================================================================
locals {
  common_tags = {
    Tenant      = var.tenant
    Environment = var.environment
    LandingZone = var.landing_zone
    Project     = var.project
    Application = var.application
    ManagedBy   = "terraform"
    Module      = "static-egress-vpc"
  }
}
