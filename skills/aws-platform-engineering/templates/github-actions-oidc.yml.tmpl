# AWS-AUTH: oidc
# Source (AWS-prescriptive):
#   https://docs.aws.amazon.com/prescriptive-guidance/latest/aws-caf-platform-perspective/platform-eng.html
#   (CAF Platform: "rely on temporary credentials")
#
# Generated by .cursor/skills/aws-platform-engineering capability
# `generate-actions-oidc-workflow` per ADR-005 G-1.
#
# Hard rules encoded below:
#   - Workflow-level `permissions: { id-token: write, contents: read }`.
#   - aws-actions/configure-aws-credentials@v4 with role-to-assume + audience.
#   - No aws-access-key-id / aws-secret-access-key anywhere.
#   - Concurrency block for any push-triggered apply step.
#   - Read-only roles for plan; write-capable roles for apply (separate ARNs).

name: {{workflow_name}}

on:
{{trigger_block}}

# Workflow-level permissions: only id-token write + contents read.
# Job-level permissions can narrow further but never broaden.
permissions:
  id-token: write
  contents: read
  pull-requests: write   # optional — drop if the workflow does not comment on PRs

concurrency:
  group: {{concurrency_group}}
  cancel-in-progress: false   # never cancel an in-flight apply

jobs:
  plan:
    name: Terraform plan ({{aws_region}})
    runs-on: ubuntu-latest
    permissions:
      id-token: write
      contents: read
      pull-requests: write
    env:
      AWS_REGION: {{aws_region}}
      TF_IN_AUTOMATION: "true"

    steps:
      - name: Checkout
        uses: actions/checkout@v4
        with:
          fetch-depth: 0

      - name: Configure AWS credentials via OIDC (read-only role)
        uses: aws-actions/configure-aws-credentials@v4
        with:
          role-to-assume: ${{ vars.{{aws_role_arn_var_plan}} }}
          aws-region: {{aws_region}}
          audience: sts.amazonaws.com
          role-session-name: gha-${{ github.run_id }}

      - name: Setup Terraform
        uses: hashicorp/setup-terraform@v3
        with:
          terraform_version: "1.9.0"
          terraform_wrapper: false

      - name: Terraform init
        run: terraform init -input=false -no-color

      - name: Terraform fmt check
        run: terraform fmt -check -recursive

      - name: Terraform validate
        run: terraform validate -no-color

      - name: Terraform plan
        id: plan
        run: terraform plan -input=false -no-color -out=tfplan
        continue-on-error: false

      - name: Terraform plan (json for policy check)
        run: terraform show -json tfplan > tfplan.json

      - name: tfsec
        uses: aquasecurity/tfsec-action@v1.0.3
        with:
          soft_fail: false

      - name: Checkov
        uses: bridgecrewio/checkov-action@master
        with:
          framework: terraform
          quiet: true
          soft_fail: false

      - name: OPA / Conftest
        run: |
          curl -sSL -o conftest.tar.gz https://github.com/open-policy-agent/conftest/releases/download/v0.55.0/conftest_0.55.0_Linux_x86_64.tar.gz
          tar xzf conftest.tar.gz
          ./conftest test tfplan.json --policy ../../policy/opa/

  # apply only runs on push to the protected branch via OIDC, with a separate
  # write-capable role ARN; job depends on plan succeeding.
  apply:
    name: Terraform apply ({{aws_region}})
    if: github.event_name == 'push' && github.ref == 'refs/heads/{{target_branch}}'
    needs: plan
    runs-on: ubuntu-latest
    environment: {{environment_name}}   # GitHub environment with required reviewers
    permissions:
      id-token: write
      contents: read
    env:
      AWS_REGION: {{aws_region}}
      TF_IN_AUTOMATION: "true"

    steps:
      - name: Checkout
        uses: actions/checkout@v4

      - name: Configure AWS credentials via OIDC (write-capable role)
        uses: aws-actions/configure-aws-credentials@v4
        with:
          role-to-assume: ${{ vars.{{aws_role_arn_var_apply}} }}
          aws-region: {{aws_region}}
          audience: sts.amazonaws.com
          role-session-name: gha-apply-${{ github.run_id }}

      - name: Setup Terraform
        uses: hashicorp/setup-terraform@v3
        with:
          terraform_version: "1.9.0"
          terraform_wrapper: false

      - name: Terraform init
        run: terraform init -input=false -no-color

      - name: Terraform apply (uses plan from artifact in real workflows)
        run: terraform apply -input=false -auto-approve -no-color

      - name: Catalyst — emit audit comment
        if: always()
        env:
          GH_TOKEN: ${{ secrets.GITHUB_TOKEN }}
        run: |
          ISSUE_NUMBER="$(grep -oP 'Refs #\K[0-9]+' <<< "${{ github.event.head_commit.message }}" || true)"
          if [ -n "$ISSUE_NUMBER" ]; then
            gh issue comment "$ISSUE_NUMBER" --body "## Catalyst — terraform apply
            **From state**: \`state/agent-working\`
            **To state**: \`state/done\`
            **Actor**: github-actions[bot]
            **Run ID**: ${{ github.run_id }}
            **Region**: {{aws_region}}
            **Result**: ${{ job.status }}"
          fi
