# Catalyst API Environment Configuration
# Copy this file to .env and fill in your values
# .env is in .gitignore and should never be committed

# Repository backend: 'memory' (default, local dev) or 'dynamodb' (production)
CATALYST_REPOSITORY=memory

# DynamoDB table name (required if CATALYST_REPOSITORY=dynamodb)
# CATALYST_DYNAMODB_TABLE=catalyst-platform-state

# DynamoDB table name via SSM parameter (alternative to direct env var)
# CATALYST_DYNAMODB_TABLE_PARAMETER=/catalyst/dynamodb/table-name

# Auth mode: 'headers' (default, dev) or 'sigv4' (production with AWS SigV4 verification)
CATALYST_AUTH_MODE=headers

# IAM group cache TTL in seconds (default: 300)
CATALYST_GROUP_CACHE_TTL=300

# AWS Region (for AWS API calls and SigV4 verification)
AWS_REGION=us-west-2

# AWS Account ID (optional, resolved from STS GetCallerIdentity if not set)
# AWS_ACCOUNT_ID=123456789012

# Catalyst API ingress allowlist (JSON array of IPs/CIDRs, for security group rules)
# CATALYST_API_INGRESS_ALLOWLIST=["73.239.59.22/32", "203.0.113.0/24"]

# Runtime secrets: map secret names from Secrets Manager
# Example: CATALYST_RUNTIME_SECRET_my_key_SECRET=/path/to/secrets/manager/secret
# CATALYST_RUNTIME_SECRET_example_SECRET=arn:aws:secretsmanager:us-west-2:123456789012:secret:my-secret

# Uvicorn settings (if running with uvicorn directly)
UVICORN_HOST=127.0.0.1
UVICORN_PORT=8000
UVICORN_RELOAD=true
