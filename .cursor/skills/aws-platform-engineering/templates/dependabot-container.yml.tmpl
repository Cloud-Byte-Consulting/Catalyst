# Dependabot — Docker base-image freshness
#
# Generated by .cursor/skills/aws-platform-engineering capability
# `generate-dependabot-container` per ADR-005 (container supply chain).
#
# Goal: keep pinned-by-digest base images fresh. Dependabot opens a PR when a
# newer digest is available for the upstream tag we track. The PR triggers
# the container-scan workflow, which gates on HIGH/CRITICAL.
#
# Source: https://docs.github.com/en/code-security/dependabot/dependabot-version-updates/configuration-options-for-the-dependabot.yml-file
#
# This snippet MERGES into the existing .github/dependabot.yml; do NOT
# overwrite the file — append the `docker` updates blocks instead.

version: 2

updates:
  # ----- repo-root Dockerfile (if any) ------------------------------------
  - package-ecosystem: "docker"
    directory: "/"
    schedule:
      interval: "weekly"
      day: "monday"
      time: "09:00"
      timezone: "America/New_York"
    open-pull-requests-limit: 5
    labels:
      - "type/kaizen"
      - "tenant/catalyst"
      - "project/platform"
      - "severity/medium"
    commit-message:
      prefix: "chore(deps)"
      include: "scope"
    reviewers:
      - "Cloud-Byte-Consulting/platform-eng"

  # ----- per-service Dockerfiles ------------------------------------------
  # Add one block per `services/<svc>/` Dockerfile location.
  - package-ecosystem: "docker"
    directory: "/services/{{service_dir}}"
    schedule:
      interval: "weekly"
      day: "monday"
      time: "09:00"
      timezone: "America/New_York"
    open-pull-requests-limit: 3
    labels:
      - "type/kaizen"
      - "tenant/catalyst"
      - "app/{{service_dir}}"
      - "severity/medium"
    commit-message:
      prefix: "chore(deps)"
      include: "scope"
    ignore:
      # Don't bump major versions automatically — major bumps land via a
      # human-driven `type/kaizen` so the change is reviewed deliberately.
      - dependency-name: "*"
        update-types: ["version-update:semver-major"]

  # ----- GitHub Actions (keeps third-party Actions pinned-by-SHA fresh) ---
  - package-ecosystem: "github-actions"
    directory: "/"
    schedule:
      interval: "weekly"
      day: "monday"
      time: "09:00"
      timezone: "America/New_York"
    open-pull-requests-limit: 5
    labels:
      - "type/kaizen"
      - "tenant/catalyst"
      - "project/platform"
      - "severity/low"
    commit-message:
      prefix: "chore(actions)"
      include: "scope"
