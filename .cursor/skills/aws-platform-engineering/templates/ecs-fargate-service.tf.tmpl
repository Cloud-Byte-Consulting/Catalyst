# ECS Fargate platform service — {{service_name}}
#
# Generated by .cursor/skills/aws-platform-engineering capability
# `generate-platform-service-skeleton` per ADR-005.
#
# Sources (AWS-prescriptive):
#   ALB-public / targets-private layout:
#     https://docs.aws.amazon.com/prescriptive-guidance/latest/load-balancer-stickiness/subnets-routing.html
#   No long-lived credentials; secrets via Secrets Manager / SSM:
#     https://docs.aws.amazon.com/prescriptive-guidance/latest/aws-caf-platform-perspective/platform-eng.html
#   Centralised observability (CloudWatch + X-Ray):
#     https://docs.aws.amazon.com/prescriptive-guidance/latest/aws-caf-platform-perspective/platform-eng.html

# ============================================================================
# variables (subset — full module would split this into variables.tf)
# ============================================================================
variable "service_name" {
  description = "Service slug (kebab-case)."
  type        = string
  default     = "{{service_name}}"
}

variable "container_image" {
  description = "Full ECR image URI including tag."
  type        = string
}

variable "container_port" {
  description = "Port the container listens on."
  type        = number
  default     = {{port}}
}

variable "health_check_path" {
  description = "HTTP health check path."
  type        = string
  default     = "{{health_check_path}}"
}

variable "vpc_id" {
  description = "VPC the service runs in."
  type        = string
}

variable "public_subnet_ids" {
  description = "Public subnet IDs for the ALB (one per AZ). Per ALB-routing best practice."
  type        = list(string)
  validation {
    condition     = length(var.public_subnet_ids) >= 2
    error_message = "ALB requires at least two public subnets across AZs."
  }
}

variable "private_subnet_ids" {
  description = "Private subnet IDs for the Fargate tasks (one per AZ)."
  type        = list(string)
  validation {
    condition     = length(var.private_subnet_ids) >= 2
    error_message = "Fargate tasks require at least two private subnets across AZs for HA."
  }
}

# ============================================================================
# locals — construct anchors
# ============================================================================
locals {
  common_tags = {
    Tenant      = var.tenant
    Environment = var.environment
    LandingZone = var.landing_zone
    Project     = var.project
    Application = var.application
    ManagedBy   = "terraform"
    Module      = "ecs-fargate-service"
    Service     = var.service_name
  }
}

# ============================================================================
# ALB (internet-facing) — lives in public subnets
# ============================================================================
resource "aws_lb" "this" {
  name               = "${var.service_name}-alb"
  internal           = false
  load_balancer_type = "application"
  security_groups    = [aws_security_group.alb.id]
  subnets            = var.public_subnet_ids

  enable_deletion_protection = var.environment == "prod"

  access_logs {
    bucket  = var.alb_log_bucket   # central Log Archive S3 bucket
    prefix  = "alb/${var.service_name}"
    enabled = true
  }

  tags = local.common_tags
}

resource "aws_lb_target_group" "this" {
  name        = "${var.service_name}-tg"
  port        = var.container_port
  protocol    = "HTTP"
  target_type = "ip"
  vpc_id      = var.vpc_id

  health_check {
    path                = var.health_check_path
    interval            = 30
    timeout             = 5
    healthy_threshold   = 2
    unhealthy_threshold = 3
    matcher             = "200-299"
  }

  tags = local.common_tags
}

resource "aws_lb_listener" "https" {
  load_balancer_arn = aws_lb.this.arn
  port              = 443
  protocol          = "HTTPS"
  ssl_policy        = "ELBSecurityPolicy-TLS13-1-2-2021-06"
  certificate_arn   = var.acm_certificate_arn

  default_action {
    type             = "forward"
    target_group_arn = aws_lb_target_group.this.arn
  }
}

# ============================================================================
# Security groups — ALB allows 443 inbound; tasks allow only ALB SG
# ============================================================================
resource "aws_security_group" "alb" {
  name        = "${var.service_name}-alb-sg"
  description = "ALB ingress for ${var.service_name}"
  vpc_id      = var.vpc_id

  ingress {
    from_port   = 443
    to_port     = 443
    protocol    = "tcp"
    cidr_blocks = ["0.0.0.0/0"]
    description = "TLS from internet"
  }

  egress {
    from_port   = 0
    to_port     = 0
    protocol    = "-1"
    cidr_blocks = ["0.0.0.0/0"]
    description = "ALB egress to targets in VPC"
  }

  tags = local.common_tags
}

resource "aws_security_group" "tasks" {
  name        = "${var.service_name}-tasks-sg"
  description = "Fargate tasks for ${var.service_name}"
  vpc_id      = var.vpc_id

  ingress {
    from_port       = var.container_port
    to_port         = var.container_port
    protocol        = "tcp"
    security_groups = [aws_security_group.alb.id]
    description     = "From ALB only"
  }

  egress {
    from_port   = 0
    to_port     = 0
    protocol    = "-1"
    cidr_blocks = ["0.0.0.0/0"]
    description = "Egress via private route table -> NAT (Network account)"
  }

  tags = local.common_tags
}

# ============================================================================
# IAM — Task Execution Role (pull image, write logs) + Task Role (app perms)
# ============================================================================
data "aws_iam_policy_document" "task_assume" {
  statement {
    actions = ["sts:AssumeRole"]
    principals {
      type        = "Service"
      identifiers = ["ecs-tasks.amazonaws.com"]
    }
  }
}

resource "aws_iam_role" "task_execution" {
  name               = "${var.service_name}-task-exec"
  assume_role_policy = data.aws_iam_policy_document.task_assume.json
  tags               = local.common_tags
}

resource "aws_iam_role_policy_attachment" "task_execution_managed" {
  role       = aws_iam_role.task_execution.name
  policy_arn = "arn:aws:iam::aws:policy/service-role/AmazonECSTaskExecutionRolePolicy"
}

resource "aws_iam_role" "task" {
  name               = "${var.service_name}-task"
  assume_role_policy = data.aws_iam_policy_document.task_assume.json
  tags               = local.common_tags
}

# Task role permissions: ADD ONLY THE SMALLEST VIABLE LIST.
# Wildcard Action+Resource is rejected by the persona (G-2). Example below.
data "aws_iam_policy_document" "task" {
  statement {
    sid    = "ReadOwnSecrets"
    effect = "Allow"
    actions = [
      "secretsmanager:GetSecretValue",
    ]
    resources = [
      "arn:aws:secretsmanager:${var.region}:${data.aws_caller_identity.current.account_id}:secret:catalyst/${var.environment}/${var.service_name}/*",
    ]
  }

  statement {
    sid    = "ReadOwnSsmParams"
    effect = "Allow"
    actions = [
      "ssm:GetParameter",
      "ssm:GetParameters",
    ]
    resources = [
      "arn:aws:ssm:${var.region}:${data.aws_caller_identity.current.account_id}:parameter/catalyst/${var.environment}/${var.service_name}/*",
    ]
  }
}

resource "aws_iam_role_policy" "task" {
  name   = "${var.service_name}-task-inline"
  role   = aws_iam_role.task.id
  policy = data.aws_iam_policy_document.task.json
}

data "aws_caller_identity" "current" {}

# ============================================================================
# CloudWatch Logs
# ============================================================================
resource "aws_cloudwatch_log_group" "this" {
  name              = "/ecs/${var.service_name}"
  retention_in_days = var.environment == "prod" ? 90 : 30
  kms_key_id        = var.logs_kms_key_arn
  tags              = local.common_tags
}

# ============================================================================
# Task definition — includes the X-Ray sidecar
# ============================================================================
resource "aws_ecs_task_definition" "this" {
  family                   = var.service_name
  network_mode             = "awsvpc"
  requires_compatibilities = ["FARGATE"]
  cpu                      = var.cpu
  memory                   = var.memory
  execution_role_arn       = aws_iam_role.task_execution.arn
  task_role_arn            = aws_iam_role.task.arn
  tags                     = local.common_tags

  container_definitions = jsonencode([
    {
      name      = var.service_name
      image     = var.container_image
      essential = true
      portMappings = [{ containerPort = var.container_port, protocol = "tcp" }]
      environment = [
        { name = "AWS_REGION", value = var.region },
        { name = "SERVICE_NAME", value = var.service_name },
        { name = "ENV", value = var.environment },
      ]
      secrets = [
        # Reference secrets by ARN; never inline.
        # { name = "DB_PASSWORD", valueFrom = "arn:aws:secretsmanager:..." }
      ]
      logConfiguration = {
        logDriver = "awslogs"
        options = {
          awslogs-group         = aws_cloudwatch_log_group.this.name
          awslogs-region        = var.region
          awslogs-stream-prefix = "app"
        }
      }
    },
    {
      name      = "xray-daemon"
      image     = "public.ecr.aws/xray/aws-xray-daemon:latest"
      essential = false
      portMappings = [{ containerPort = 2000, protocol = "udp" }]
      logConfiguration = {
        logDriver = "awslogs"
        options = {
          awslogs-group         = aws_cloudwatch_log_group.this.name
          awslogs-region        = var.region
          awslogs-stream-prefix = "xray"
        }
      }
    },
  ])
}

# ============================================================================
# Service — runs in PRIVATE subnets (G-6 ALB best practice)
# ============================================================================
resource "aws_ecs_service" "this" {
  name            = var.service_name
  cluster         = var.cluster_arn
  task_definition = aws_ecs_task_definition.this.arn
  desired_count   = var.environment == "prod" ? 3 : 1
  launch_type     = "FARGATE"

  network_configuration {
    subnets          = var.private_subnet_ids   # PRIVATE per G-6
    security_groups  = [aws_security_group.tasks.id]
    assign_public_ip = false                     # never true for tasks
  }

  load_balancer {
    target_group_arn = aws_lb_target_group.this.arn
    container_name   = var.service_name
    container_port   = var.container_port
  }

  deployment_controller {
    type = "ECS"
  }

  deployment_circuit_breaker {
    enable   = true
    rollback = true
  }

  tags = local.common_tags
}

# ============================================================================
# CloudWatch alarms — p95 latency + 5xx rate + unhealthy hosts
# ============================================================================
resource "aws_cloudwatch_metric_alarm" "alb_5xx_rate" {
  alarm_name          = "${var.service_name}-alb-5xx"
  comparison_operator = "GreaterThanThreshold"
  evaluation_periods  = 2
  metric_name         = "HTTPCode_Target_5XX_Count"
  namespace           = "AWS/ApplicationELB"
  period              = 60
  statistic           = "Sum"
  threshold           = 10
  alarm_description   = "ALB 5xx > 10/min for ${var.service_name}"
  treat_missing_data  = "notBreaching"
  alarm_actions       = [var.alarm_sns_topic_arn]

  dimensions = {
    LoadBalancer = aws_lb.this.arn_suffix
  }

  tags = local.common_tags
}
