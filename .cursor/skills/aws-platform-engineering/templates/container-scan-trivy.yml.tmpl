# AWS-AUTH: oidc
# Container scan + SBOM workflow (Trivy primary)
#
# Generated by .cursor/skills/aws-platform-engineering capability
# `generate-container-scan-workflow` per ADR-005 (container supply chain).
#
# Sources (cited in research doc §Container supply chain):
#   - Trivy:                     https://trivy.dev/
#   - aquasecurity/trivy-action: https://github.com/aquasecurity/trivy-action
#   - SPDX 2.3:                  https://spdx.dev/
#   - CycloneDX 1.5:             https://cyclonedx.org/
#   - GitHub code scanning:      https://docs.github.com/en/code-security/code-scanning
#   - SARIF spec:                https://docs.oasis-open.org/sarif/sarif/v2.1.0/sarif-v2.1.0.html
#   - ECR enhanced scanning:     https://docs.aws.amazon.com/AmazonECR/latest/userguide/image-scanning-enhanced.html
#
# Hard rules encoded:
#   - Build job outputs image_uri; downstream jobs consume it.
#   - SBOM job emits BOTH SPDX 2.3 JSON and CycloneDX 1.5 JSON; uploads as artifact.
#   - Vuln job fails on HIGH,CRITICAL by default; threshold configurable.
#   - SARIF uploaded to GitHub Security tab via github/codeql-action/upload-sarif.
#   - Documented CVEs ignored via committed `.trivyignore` (with rationale lines).
#   - Push to ECR via OIDC role (no static AWS keys) per G-1.
#   - Third-party Actions pinned by SHA (placeholders below).

name: {{workflow_name}}

on:
  pull_request:
    paths:
      - "{{dockerfile_dir}}/**"
      - ".github/workflows/{{workflow_filename}}"
  push:
    branches: [release]
    paths:
      - "{{dockerfile_dir}}/**"
  workflow_dispatch:

permissions:
  id-token: write       # OIDC for AWS
  contents: read
  packages: read
  security-events: write   # SARIF upload to Security tab
  pull-requests: write     # comment scan summary on PRs

concurrency:
  group: container-scan-${{ github.workflow }}-${{ github.ref }}
  cancel-in-progress: false

env:
  AWS_REGION: {{aws_region}}
  ECR_REPO: {{ecr_repo}}
  IMAGE_TAG: ${{ github.sha }}
  # Severity gate — override per workflow if a higher tolerance is needed and
  # documented in PR body.
  SEVERITY_GATE: "HIGH,CRITICAL"

jobs:
  # ---------------------------------------------------------------------------
  # 1. Build the image and (only on push to release) push to ECR via OIDC
  # ---------------------------------------------------------------------------
  build:
    name: Build image
    runs-on: ubuntu-latest
    outputs:
      image_uri: ${{ steps.tag.outputs.image_uri }}
    steps:
      - name: Checkout
        uses: actions/checkout@v4   # pin to a verified SHA before merge

      - name: Configure AWS credentials via OIDC
        uses: aws-actions/configure-aws-credentials@v4   # pin to a verified SHA before merge
        with:
          role-to-assume: ${{ vars.OIDC_ROLE_ECR_PUSH }}
          aws-region: ${{ env.AWS_REGION }}
          audience: sts.amazonaws.com
          role-session-name: gha-build-${{ github.run_id }}

      - name: Login to Amazon ECR
        id: ecr_login
        uses: aws-actions/amazon-ecr-login@v2   # pin to a verified SHA before merge

      - name: Compute image tag
        id: tag
        run: |
          IMAGE_URI="${{ steps.ecr_login.outputs.registry }}/${{ env.ECR_REPO }}:${{ env.IMAGE_TAG }}"
          echo "image_uri=$IMAGE_URI" >> "$GITHUB_OUTPUT"

      - name: Set up Docker Buildx
        uses: docker/setup-buildx-action@v3   # pin to a verified SHA before merge

      - name: Build (and push only on release)
        uses: docker/build-push-action@v6   # pin to a verified SHA before merge
        with:
          context: {{dockerfile_dir}}
          file: {{dockerfile_dir}}/Dockerfile
          push: ${{ github.event_name == 'push' && github.ref == 'refs/heads/release' }}
          tags: ${{ steps.tag.outputs.image_uri }}
          provenance: true
          sbom: false   # SBOM is produced explicitly in a downstream job
          cache-from: type=gha
          cache-to: type=gha,mode=max
          load: ${{ github.event_name == 'pull_request' }}

      - name: Save image to artifact (PRs only — local image for scan jobs)
        if: github.event_name == 'pull_request'
        run: |
          docker save -o /tmp/image.tar ${{ steps.tag.outputs.image_uri }}

      - name: Upload image artifact
        if: github.event_name == 'pull_request'
        uses: actions/upload-artifact@v4   # pin to a verified SHA before merge
        with:
          name: container-image
          path: /tmp/image.tar
          retention-days: 1

  # ---------------------------------------------------------------------------
  # 2. SBOM — SPDX 2.3 JSON + CycloneDX 1.5 JSON
  # ---------------------------------------------------------------------------
  sbom:
    name: SBOM (SPDX + CycloneDX)
    runs-on: ubuntu-latest
    needs: build
    steps:
      - name: Checkout
        uses: actions/checkout@v4   # pin to a verified SHA before merge

      - name: Download image artifact (PRs)
        if: github.event_name == 'pull_request'
        uses: actions/download-artifact@v4   # pin to a verified SHA before merge
        with:
          name: container-image
          path: /tmp

      - name: Load image (PRs)
        if: github.event_name == 'pull_request'
        run: docker load -i /tmp/image.tar

      - name: Configure AWS credentials via OIDC (release pushes — pull from ECR)
        if: github.event_name != 'pull_request'
        uses: aws-actions/configure-aws-credentials@v4   # pin to a verified SHA before merge
        with:
          role-to-assume: ${{ vars.OIDC_ROLE_ECR_PULL }}
          aws-region: ${{ env.AWS_REGION }}
          audience: sts.amazonaws.com

      - name: Login to Amazon ECR (release pushes)
        if: github.event_name != 'pull_request'
        uses: aws-actions/amazon-ecr-login@v2   # pin to a verified SHA before merge

      # SPDX 2.3 JSON
      - name: Generate SBOM (SPDX 2.3 JSON) via Trivy
        uses: aquasecurity/trivy-action@0.24.0   # pin to a verified SHA before merge
        with:
          scan-type: image
          image-ref: ${{ needs.build.outputs.image_uri }}
          format: spdx-json
          output: sbom.spdx.json
        env:
          TRIVY_DISABLE_VEX_NOTICE: "true"

      # CycloneDX 1.5 JSON
      - name: Generate SBOM (CycloneDX 1.5 JSON) via Trivy
        uses: aquasecurity/trivy-action@0.24.0   # pin to a verified SHA before merge
        with:
          scan-type: image
          image-ref: ${{ needs.build.outputs.image_uri }}
          format: cyclonedx
          output: sbom.cdx.json

      - name: Upload SBOMs as workflow artifact
        uses: actions/upload-artifact@v4   # pin to a verified SHA before merge
        with:
          name: sbom-${{ github.sha }}
          path: |
            sbom.spdx.json
            sbom.cdx.json
          retention-days: 90

      # Optional: attach SBOMs to a GitHub Release (release-tagged pushes only)
      - name: Attach SBOMs to GitHub Release (when tagged)
        if: startsWith(github.ref, 'refs/tags/')
        uses: softprops/action-gh-release@v2   # pin to a verified SHA before merge
        with:
          files: |
            sbom.spdx.json
            sbom.cdx.json

  # ---------------------------------------------------------------------------
  # 3. Vuln scan — fail on SEVERITY_GATE; SARIF -> GitHub Security tab
  # ---------------------------------------------------------------------------
  vuln-scan:
    name: Trivy vuln scan (gate: ${{ env.SEVERITY_GATE }})
    runs-on: ubuntu-latest
    needs: build
    steps:
      - name: Checkout
        uses: actions/checkout@v4   # pin to a verified SHA before merge

      - name: Download image artifact (PRs)
        if: github.event_name == 'pull_request'
        uses: actions/download-artifact@v4   # pin to a verified SHA before merge
        with:
          name: container-image
          path: /tmp

      - name: Load image (PRs)
        if: github.event_name == 'pull_request'
        run: docker load -i /tmp/image.tar

      - name: Configure AWS credentials via OIDC (release pushes)
        if: github.event_name != 'pull_request'
        uses: aws-actions/configure-aws-credentials@v4   # pin to a verified SHA before merge
        with:
          role-to-assume: ${{ vars.OIDC_ROLE_ECR_PULL }}
          aws-region: ${{ env.AWS_REGION }}
          audience: sts.amazonaws.com

      - name: Login to Amazon ECR (release pushes)
        if: github.event_name != 'pull_request'
        uses: aws-actions/amazon-ecr-login@v2   # pin to a verified SHA before merge

      # SARIF for GitHub Security tab — never fails the job on its own
      - name: Trivy scan (SARIF; for GitHub Security tab)
        uses: aquasecurity/trivy-action@0.24.0   # pin to a verified SHA before merge
        with:
          scan-type: image
          image-ref: ${{ needs.build.outputs.image_uri }}
          format: sarif
          output: trivy-results.sarif
          severity: ${{ env.SEVERITY_GATE }}
          ignore-unfixed: false
          vuln-type: os,library
          # .trivyignore in repo root governs which CVEs are documented
          # exceptions; each line MUST have a `# rationale: ...` comment.

      - name: Upload SARIF to GitHub Security tab
        if: always()
        uses: github/codeql-action/upload-sarif@v3   # pin to a verified SHA before merge
        with:
          sarif_file: trivy-results.sarif
          category: trivy-image

      # The hard gate — fails the build if vulns at or above SEVERITY_GATE remain
      - name: Trivy scan (gate — fail on ${{ env.SEVERITY_GATE }})
        uses: aquasecurity/trivy-action@0.24.0   # pin to a verified SHA before merge
        with:
          scan-type: image
          image-ref: ${{ needs.build.outputs.image_uri }}
          format: table
          severity: ${{ env.SEVERITY_GATE }}
          ignore-unfixed: false
          vuln-type: os,library
          exit-code: "1"
          # Documented exceptions go in `.trivyignore` (one CVE-id per line +
          # `# rationale: <text>` line above it). Reviewed quarterly.
        env:
          TRIVY_DISABLE_VEX_NOTICE: "true"

      - name: Comment scan summary on PR
        if: github.event_name == 'pull_request' && always()
        uses: actions/github-script@v7   # pin to a verified SHA before merge
        env:
          IMAGE_URI: ${{ needs.build.outputs.image_uri }}
          GATE: ${{ env.SEVERITY_GATE }}
          STATUS: ${{ job.status }}
        with:
          script: |
            const body = [
              '## Container scan — Trivy',
              `**Image**: \`${process.env.IMAGE_URI}\``,
              `**Gate**: \`${process.env.GATE}\``,
              `**Result**: \`${process.env.STATUS}\``,
              '',
              'See the SARIF results in the Security tab and the SBOM in the workflow artifacts.',
              '',
              'Documented exceptions live in `.trivyignore` (each entry MUST have a rationale comment).',
            ].join('\n');
            await github.rest.issues.createComment({
              owner: context.repo.owner,
              repo: context.repo.repo,
              issue_number: context.issue.number,
              body,
            });
