# Catalyst bootstrap environment variables (template)
# Copy this file to .env and fill in the values. .env is gitignored.
# Source .env before running scripts/bootstrap-aws-account.sh.

# Target AWS account + region for the Catalyst stack
AWS_REGION=us-east-1
AWS_ACCOUNT_ID=

# Repo allowed to assume the OIDC roles (must match bootstrap trust policy)
GITHUB_REPOSITORY=

# IAM principal allowed to assume the bootstrap-admin role (use root ARN for one-time bootstrap)
BOOTSTRAP_ADMIN_PRINCIPAL_ARN=

# Resource prefix used by bootstrap + Terraform (default: catalyst)
CATALYST_PREFIX=catalyst

# AWS credentials for local operator use (NEVER commit real values)
# Prefer aws sso login or temporary STS credentials; long-lived keys here are a last resort.
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=
