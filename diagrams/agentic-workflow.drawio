        <!-- Six AGENTS.md gates (numbered) -->
        <mxCell id="gates-title" value="Six AGENTS.md Gates (codified by ADR-011)" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=13;fontStyle=1;fontColor=#232F3E;" vertex="1" parent="1">
          <mxGeometry x="40" y="240" width="800" height="24" as="geometry" />
        </mxCell>

        <mxCell id="gate-1" value="1. Model Decision Log&#10;### Agent Decision Log on issue&#10;Model + fallback + rationale" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F0F4FA;strokeColor=#232F3E;fontSize=10;fontColor=#232F3E;spacing=8;align=left;" vertex="1" parent="1">
          <mxGeometry x="40" y="280" width="180" height="80" as="geometry" />
        </mxCell>
        <mxCell id="gate-2" value="2. RLM Trigger&#10;Artifacts &gt; 50k chars route&#10;through ADR-004 scaffold" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F0F4FA;strokeColor=#232F3E;fontSize=10;fontColor=#232F3E;spacing=8;align=left;" vertex="1" parent="1">
          <mxGeometry x="240" y="280" width="180" height="80" as="geometry" />
        </mxCell>
        <mxCell id="gate-3" value="3. AWS OIDC Only&#10;No long-lived keys (ADR-006)&#10;Enforced by validate_workflows.py" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F0F4FA;strokeColor=#232F3E;fontSize=10;fontColor=#232F3E;spacing=8;align=left;" vertex="1" parent="1">
          <mxGeometry x="440" y="280" width="180" height="80" as="geometry" />
        </mxCell>
        <mxCell id="gate-4" value="4. Container Security Gate&#10;Trivy HIGH/CRITICAL&#10;SBOM (SPDX 2.3, CycloneDX 1.5)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F0F4FA;strokeColor=#232F3E;fontSize=10;fontColor=#232F3E;spacing=8;align=left;" vertex="1" parent="1">
          <mxGeometry x="640" y="280" width="180" height="80" as="geometry" />
        </mxCell>
        <mxCell id="gate-5" value="5. Pre-PR Peer Review&#10;Sub-agent fork BEFORE gh pr create&#10;Disposition table mandatory" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE6F0;strokeColor=#E7157B;fontSize=10;fontColor=#232F3E;fontStyle=1;spacing=8;align=left;" vertex="1" parent="1">
          <mxGeometry x="840" y="280" width="180" height="80" as="geometry" />
        </mxCell>
        <mxCell id="gate-6" value="6. Secret Scanning&#10;GitHub MCP gate on any&#10;file/credential addition" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F0F4FA;strokeColor=#232F3E;fontSize=10;fontColor=#232F3E;spacing=8;align=left;" vertex="1" parent="1">
          <mxGeometry x="40" y="380" width="180" height="80" as="geometry" />
        </mxCell>

        <!-- Peer-review sub-agent spawn (gate 5 deep-dive) -->
        <mxCell id="prr-group" value="Pre-PR Peer Review (gate 5 detail)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#E7157B;fontSize=12;fontStyle=1;container=1;collapsible=0;verticalAlign=top;align=left;spacingLeft=12;fontColor=#E7157B;" vertex="1" parent="1">
          <mxGeometry x="240" y="380" width="780" height="240" as="geometry" />
        </mxCell>

        <mxCell id="prr-main-agent" value="Implementing agent&#10;(work complete, pre-PR)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E7F4FA;strokeColor=#147EBA;fontSize=11;fontColor=#232F3E;spacing=8;" vertex="1" parent="prr-group">
          <mxGeometry x="20" y="40" width="180" height="60" as="geometry" />
        </mxCell>

        <mxCell id="prr-fork" value="Agent.spawn(subagent_type=&#10;general-purpose,&#10;prompt=peer-review-prompt)" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFE6F0;strokeColor=#E7157B;fontSize=10;fontColor=#232F3E;spacing=6;" vertex="1" parent="prr-group">
          <mxGeometry x="240" y="30" width="180" height="80" as="geometry" />
        </mxCell>

        <mxCell id="prr-sub" value="Peer-review sub-agent&#10;(independent context window)&#10;Reviews: AC, ADR, security,&#10;coverage, naming" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFEEFA;strokeColor=#E7157B;fontSize=10;fontColor=#232F3E;spacing=8;align=left;" vertex="1" parent="prr-group">
