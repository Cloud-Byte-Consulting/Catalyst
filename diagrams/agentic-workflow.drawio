        <!-- Drift andon flow -->
        <mxCell id="andon-title" value="Drift Andon — Auto-Issue Pattern" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=13;fontStyle=1;fontColor=#D13212;" vertex="1" parent="1">
          <mxGeometry x="40" y="870" width="800" height="24" as="geometry" />
        </mxCell>

        <mxCell id="andon-cron" value="tf-drift.yml runs daily 06:00 UTC&#10;terraform plan -detailed-exitcode" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFAEB;strokeColor=#ED7100;fontSize=10;fontColor=#232F3E;spacing=8;align=left;" vertex="1" parent="1">
          <mxGeometry x="40" y="910" width="220" height="60" as="geometry" />
        </mxCell>

        <mxCell id="andon-detect" value="Exit code 2?&#10;(non-zero diff = drift)" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FBE9E7;strokeColor=#D13212;fontSize=10;fontColor=#232F3E;spacing=6;" vertex="1" parent="1">
          <mxGeometry x="300" y="910" width="180" height="60" as="geometry" />
        </mxCell>

        <mxCell id="andon-sns" value="SNS publish&#10;DRIFT_SNS_TOPIC_ARN" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE6F0;strokeColor=#E7157B;fontSize=10;fontColor=#232F3E;spacing=8;align=left;" vertex="1" parent="1">
