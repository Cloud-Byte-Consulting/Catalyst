        <mxCell id="e-cron-detect" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;html=1;strokeColor=#5A6C7D;fontSize=10;endArrow=classic;" edge="1" parent="1" source="andon-cron" target="andon-detect">
