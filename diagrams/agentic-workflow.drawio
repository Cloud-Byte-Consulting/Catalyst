        <!-- Legend -->
        <mxCell id="legend" value="Legend  ━━ state transition  ┄┄ surprise / kaizen  ┄┄ andon loop back to state machine  ◇ decision/fork point&#10;Source of truth: AGENTS.md (contract) + CLAUDE.md (guardrails) + ADR-011 (decision record) + docs/ai-workflow-narrative.md (evidence catalog)&#10;Workflow files: .github/workflows/{terraform,service-cd,tf-drift,pr-checks,ci-smoke,teardown,teardown-scheduled,validate-policies,bootstrap-smoke}.yml" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=10;fillColor=#FFFFFF;strokeColor=#5A6C7D;rounded=1;spacing=8;fontColor=#232F3E;" vertex="1" parent="1">
