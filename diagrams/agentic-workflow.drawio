        <!-- RLM scaffold -->
        <mxCell id="rlm" value="RLM Scaffold (ADR-004)&#10;&#10;Trigger: artifact &gt; 50k chars&#10;Used for: long diffs, terraform plans,&#10;CloudWatch exports, multi-file reads&#10;&#10;Scripts: .claude/skills/rlm/rlm_repl.py&#10;Sub-agent: .claude/agents/rlm-subcall.md&#10;&#10;Output: chunk-confidence-tracked synthesis" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F0F8E6;strokeColor=#7AA116;fontSize=10;fontColor=#232F3E;fontStyle=0;spacing=10;align=left;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="840" y="660" width="220" height="180" as="geometry" />
