        <!-- Worked-example callouts -->
        <mxCell id="example-147" value="Worked example: PR #147&#10;Triage agent hypothesized paths: filter.&#10;Peer-review sub-agent ran actionlint,&#10;returned HIGH-confidence diagnosis on&#10;secrets.* in step-level if: (different,&#10;correct root cause). Gate 5 working." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=10;fillColor=#FFFAEB;strokeColor=#ED7100;rounded=1;spacing=8;fontColor=#232F3E;" vertex="1" parent="1">
