        <mxCell id="andon-issue" value="gh issue create&#10;state/pending + type/kaizen" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF7E6;strokeColor=#ED7100;fontSize=10;fontColor=#232F3E;spacing=8;align=left;" vertex="1" parent="1">
          <mxGeometry x="520" y="950" width="160" height="40" as="geometry" />
        </mxCell>

        <mxCell id="andon-back" value="Andon edge: drift becomes a tracked issue,&#10;re-enters the state machine at state/pending.&#10;Agent picks it up on next session." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=10;fillColor=#FFFFFF;strokeColor=#D13212;rounded=1;spacing=8;fontColor=#232F3E;fontStyle=2;" vertex="1" parent="1">
          <mxGeometry x="720" y="910" width="340" height="80" as="geometry" />
        </mxCell>

