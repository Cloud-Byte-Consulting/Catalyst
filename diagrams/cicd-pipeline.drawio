        <!-- ============ OIDC ROLES ============ -->
        <mxCell id="role-plan" value="catalyst-github-plan&#10;ReadOnlyAccess&#10;sub: pull_request" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF0F4;strokeColor=#DD344C;fontSize=10;fontColor=#232F3E;spacing=8;align=left;fontStyle=1;" vertex="1" parent="1">
