        <mxCell id="e-drift-detect-issue" value="exit code 2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#D13212;endArrow=classic;fontSize=9;fontStyle=2;" edge="1" parent="wf-drift" source="step-drift-detect" target="step-drift-issue">
