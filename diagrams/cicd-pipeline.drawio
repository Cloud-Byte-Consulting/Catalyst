        <mxCell id="step-sticky" value="Sticky PR comment&#10;(rendered plan)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF8C5;strokeColor=#9A6700;fontSize=10;fontColor=#232F3E;spacing=6;align=center;fontStyle=2;" vertex="1" parent="wf-tf-plan">
