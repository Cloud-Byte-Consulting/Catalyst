        <mxCell id="role-apply-td" value="catalyst-github-apply&#10;(also teardown)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF0F4;strokeColor=#DD344C;fontSize=10;fontColor=#232F3E;spacing=8;align=left;fontStyle=2;" vertex="1" parent="1">
