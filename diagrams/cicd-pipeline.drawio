        <!-- ============ OUTCOMES ============ -->
        <mxCell id="out-pr-checks" value="PR check suite green&#10;(SARIF on code scanning)&#10;PR mergeable iff all gates pass" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F0FCE6;strokeColor=#34A853;fontSize=11;fontColor=#232F3E;spacing=8;align=left;fontStyle=1;" vertex="1" parent="1">
