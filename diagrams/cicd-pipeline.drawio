        <!-- TERRAFORM.YML APPLY (push to release) -->
        <mxCell id="wf-tf-apply" value="terraform.yml — apply job (push to release)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAFBE1;strokeColor=#1F883D;fontSize=12;fontStyle=1;container=1;collapsible=0;verticalAlign=top;align=left;spacingLeft=12;fontColor=#1F883D;" vertex="1" parent="1">
